#!/usr/bin/env bash
set -euo pipefail

for cmd in curl jq; do
  command -v "$cmd" >/dev/null 2>&1 || { echo "Error: $cmd is required. Install with: brew install $cmd" >&2; exit 1; }
done

usage() {
  echo "Usage: jira-labels <area|scrum>" >&2
  exit 1
}

[[ $# -lt 1 ]] && usage

MODE="$1"

if [[ -z "${JIRA_EMAIL:-}" || -z "${JIRA_TOKEN:-}" || -z "${JIRA_HOST:-}" ]]; then
  if [[ -f "$HOME/secrets/jira.env" ]]; then
    source "$HOME/secrets/jira.env"
  else
    echo "Error: JIRA_EMAIL, JIRA_TOKEN, and JIRA_HOST must be set." >&2
    echo "Either export them or create ~/secrets/jira.env with:" >&2
    echo "  JIRA_EMAIL=you@example.com" >&2
    echo "  JIRA_TOKEN=your-api-token" >&2
    echo "  JIRA_HOST=your-instance.atlassian.net" >&2
    exit 1
  fi
fi

for var in JIRA_EMAIL JIRA_TOKEN JIRA_HOST; do
  if [[ -z "${!var:-}" ]]; then
    echo "Error: $var is not set (check ~/secrets/jira.env)" >&2
    exit 1
  fi
done

AUTH="Authorization: Basic $(echo -n "${JIRA_EMAIL}:${JIRA_TOKEN}" | base64)"
ENDPOINT="https://${JIRA_HOST}/rest/api/2/jql/autocompletedata/suggestions"

query_labels() {
  local prefix="$1"
  curl -sf -G "$ENDPOINT" \
    -H "$AUTH" \
    -H "Accept: application/json" \
    --data-urlencode "fieldName=labels" \
    --data-urlencode "fieldValue=$prefix" 2>/dev/null \
  | jq -r '.results[]?.value // empty' 2>/dev/null || true
}

case "$MODE" in
  area)
    for letter in {a..z}; do
      query_labels "dashboard-area-${letter}"
    done | grep '^dashboard-area-' | sort -u
    ;;
  scrum)
    for letter in {a..z}; do
      query_labels "dashboard-${letter}"
    done | grep -E '^dashboard-.*-scrum$' | sort -u
    ;;
  *)
    usage
    ;;
esac
