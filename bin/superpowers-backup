#!/usr/bin/env bash
#
# superpowers-backup — back up superpowers docs from the current worktree into
# the rhoai-work workspace, which serves as a personal historical record.
#
# Superpowers docs (specs, plans, etc.) live under docs/superpowers/ in a
# product repo worktree but must NOT be checked in to product repos like
# odh-dashboard. This script copies the current worktree's docs/superpowers/
# contents into ~/git/rhoai-work/superpowers-backups/{repo}/{subdir}/ where
# {repo} is the repo name (e.g. odh-dashboard) and {subdir} is the worktree
# title ($WORKTREE_TITLE) if set, otherwise the current git branch. Using the
# worktree title keeps backups stable per worktree even if the branch changes
# while specs are still uncommitted. Alongside the backed-up files it writes
# worktree-info.txt capturing the output of `worktree info` for the worktree
# the backup came from.
#
# Example: run from an odh-dashboard worktree titled "wt rhoaieng-68987"
# containing docs/superpowers/specs/... and it will be copied to
#   ~/git/rhoai-work/superpowers-backups/odh-dashboard/wt-rhoaieng-68987/specs/...
# with worktree metadata in
#   ~/git/rhoai-work/superpowers-backups/odh-dashboard/wt-rhoaieng-68987/worktree-info.txt

set -euo pipefail

RHOAI_WORK="$HOME/git/rhoai-work"
BACKUPS_DIR="$RHOAI_WORK/superpowers-backups"

src="$PWD/docs/superpowers"

if [[ ! -d "$src" ]]; then
  echo "superpowers-backup: no docs/superpowers directory found in $PWD" >&2
  exit 1
fi

# Determine the repo name. Use the common git dir (shared across all worktrees)
# rather than the worktree toplevel, whose basename would be the branch/worktree
# name (e.g. rhoaieng-68987) instead of the repo name (e.g. odh-dashboard).
if ! common_git_dir="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)"; then
  echo "superpowers-backup: current directory is not inside a git repository" >&2
  exit 1
fi
repo="$(basename "$(dirname "$common_git_dir")")"

# Determine the subdirectory that identifies this backup. Prefer the worktree
# title ($WORKTREE_TITLE, set by the `worktree` tool) so backups stay stable
# per worktree even if the branch changes while specs are uncommitted. Fall
# back to the current branch, then to a short commit hash if detached.
if [[ -n "${WORKTREE_TITLE:-}" ]]; then
  subdir="$WORKTREE_TITLE"
else
  subdir="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
  if [[ -z "$subdir" || "$subdir" == "HEAD" ]]; then
    subdir="detached-$(git rev-parse --short HEAD 2>/dev/null || echo unknown)"
  fi
fi
# The value can contain slashes (e.g. branch feature/foo) or spaces (e.g. the
# title "wt rhoaieng-68987"); flatten to a single, filesystem-friendly level.
subdir="${subdir//\//-}"
subdir="${subdir// /-}"

dest="$BACKUPS_DIR/$repo/$subdir"
mkdir -p "$dest"

echo "superpowers-backup: $src -> $dest"

# Capture worktree metadata alongside the backup. Strip ANSI color codes so
# the file is plain text. Non-fatal if `worktree` isn't available.
info_file="$dest/worktree-info.txt"
if command -v worktree >/dev/null 2>&1; then
  if worktree info 2>&1 | sed $'s/\033\\[[0-9;]*m//g' > "$info_file"; then
    echo "  [info] worktree-info.txt"
  else
    echo "superpowers-backup: warning: 'worktree info' failed; worktree-info.txt may be incomplete" >&2
  fi
else
  echo "superpowers-backup: warning: 'worktree' command not found; skipping worktree-info.txt" >&2
fi

# Walk every file under docs/superpowers/, classify it against the existing
# backup (new / updated / unchanged), then copy it. Uses a null-delimited find
# to handle paths with spaces safely.
new_count=0
updated_count=0
unchanged_count=0

while IFS= read -r -d '' file; do
  # Path relative to the source root (e.g. specs/example.md).
  rel="${file#"$src"/}"
  target="$dest/$rel"

  if [[ ! -e "$target" ]]; then
    status="new"
    new_count=$((new_count + 1))
  elif ! cmp -s "$file" "$target"; then
    status="updated"
    updated_count=$((updated_count + 1))
  else
    status="unchanged"
    unchanged_count=$((unchanged_count + 1))
  fi

  mkdir -p "$(dirname "$target")"
  cp -p "$file" "$target"

  printf '  [%s] %s\n' "$status" "$rel"
done < <(find "$src" -type f -print0)

echo "superpowers-backup: $new_count new, $updated_count updated, $unchanged_count unchanged"
